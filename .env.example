# KONFIGURASI DATABASE
# Pilih salah satu: Lokal (MySQL XAMPP) atau TiDB Cloud

# 1. Opsi TiDB Cloud (Serverless)
# Ambil kredensial dari TiDB Cloud Dashboard -> Overview -> Connect
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_DATABASE=pemesanan_instalasi_listrik
# DB_USERNAME=xxxxxx.root
# DB_PASSWORD=your_tidb_password
# DB_SSL=true

# 2. Opsi Lokal MySQL (Default)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pemesanan_instalasi_listrik
DB_USERNAME=root
DB_PASSWORD=
DB_SSL=false
