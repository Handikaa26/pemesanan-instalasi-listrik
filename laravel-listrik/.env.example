APP_NAME="Pemesanan Instalasi Listrik PT. Eksavindo Mitra Mandiri"
APP_ENV=production
APP_KEY=base64:ZWtzYXZpbmRvbGlzdHJpa2xhcmF2ZWxzZWN1cmUyMDI2MTI=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://nama-project-anda.vercel.app

# LOGGING & SESSION (WAJIB DI VERCEL KARENA FILESYSTEM READ-ONLY)
LOG_CHANNEL=stderr
SESSION_DRIVER=cookie
CACHE_STORE=array
QUEUE_CONNECTION=sync

# KONEKSI DATABASE (TiDB Cloud)
DB_CONNECTION=mysql
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=pemesanan_instalasi_listrik
DB_USERNAME=2UcDyhDLXTAhFB5.root
DB_PASSWORD=sN8A0EdoIePnE5Ib

# SSL / CA UNTUK TIDB CLOUD
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
TIDB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# Alternatif jika Anda menyimpan file CA sendiri di repo, misalnya: storage/certs/isrgrootx1.pem
# MYSQL_ATTR_SSL_CA=/var/task/storage/certs/isrgrootx1.pem
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true

# MIDTRANS PAYMENT GATEWAY
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
